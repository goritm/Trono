<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44F5B82E">
    <item>
        <layer-list>
            <!-- Chunky 3D gold-tinted obsidian lip -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#11141B" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- Obsidian face with warm gold border -->
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#262B38" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1.8dp"
                        android:color="#F5B82E" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
