<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/trono_widget_bg"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Trono"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/widget_today_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0"
            android:textColor="#F5B82E"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_avg_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:text="0.0/d"
            android:textColor="#989DA8"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3-state flicker-free flipper:
         0 = Idle (👑 +1 | ⏱)
         1 = Success flash (✓ +1!)
         2 = Active live timer (Chronometer ✓ | ✕) -->
    <ViewFlipper
        android:id="@+id/widget_button_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- Child 0: Idle action row -->
        <LinearLayout
            android:id="@+id/widget_idle_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_log_poop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/trono_widget_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:text="👑 +1"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_start_timer"
                android:layout_width="46dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@drawable/trono_widget_btn_timer"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingBottom="4dp"
                android:text="⏱"
                android:textColor="#F5B82E"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Child 1: Saved confirmation flash -->
        <TextView
            android:id="@+id/btn_log_success"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/trono_widget_btn_success"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="✓ +1!"
            android:textColor="#1E222B"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <!-- Child 2: Live ticking Chronometer + Finish / Cancel -->
        <LinearLayout
            android:id="@+id/widget_timer_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_finish_timer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/trono_widget_btn_timer"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp">

                <Chronometer
                    android:id="@+id/widget_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F5B82E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="✓"
                    android:textColor="#2F855A"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_cancel_timer"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@drawable/trono_widget_btn_cancel"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingBottom="4dp"
                android:text="✕"
                android:textColor="#989DA8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>
